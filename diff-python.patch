+      bhBullets.splice(i, 1);
+      continue;
+    }
+    
+    if (
+      b.x + 20 > playerHitbox.left &&
+      b.x + 10 < playerHitbox.right &&
+      b.y + 20 > playerHitbox.top &&
+      b.y + 10 < playerHitbox.bottom
+    ) {
+      endBulletHell(elapsed);
+      return;
+    }
+  }
+  
+  requestAnimationFrame(bhGameLoop);
+}
