+function joinPartyLobby() {
+  initSocket();
+  if (typeof btnJoinRoom !== 'undefined' && btnJoinRoom) {
+    btnJoinRoom.classList.add('hidden');
+  }
+  bhContainer.classList.remove('hidden');
+  bhGameoverModal.classList.add('hidden');
+  bhEntities.innerHTML = '';
+  partyOthers = {};
+  bhBullets = [];
